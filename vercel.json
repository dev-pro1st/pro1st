{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|AspiegelBot|Bytespider|DataForSeoBot|BLEXBot|serpstatbot|Barkrowler|MegaIndex|ZoominfoBot|ImagesiftBot|Diffbot|GPTBot|CCBot|ClaudeBot|anthropic-ai|Amazonbot|meta-externalagent|Scrapy|HTTrack|masscan|zgrab).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
